{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mcping": {
      "type": "remote",
      "url": "https://@@ADDRESS@@:@@PORT@@/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MCPING_TOKEN}"
      }
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-mcping": {
          "name": "qwen3-mcping"
        }
      }
    }
  },
  "model": "ollama/qwen3-mcping"
}
