[Unit]
Description=MCPing setup portal (web pages on port 443)
After=network-online.target mcping.service
Wants=network-online.target

[Service]
User=mcping
Group=mcping
Environment=MCPING_TLS_DIR=/var/lib/mcping/tls
ExecStart=/home/mcping/mcping/.venv/bin/python -m mcping.portal --port 443
# binding a port below 1024 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
